<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite parallel = "tests" name="Test Suite">
    <groups>
            <run>
                <include name="smoke"/>
            </run>
    </groups>
    <listeners>
        <listener class-name="brightlyTestQa.ui.testComponents.Listeners"/>
    </listeners>
    <test  thread-count="5" name="ErrorValidation">
        <classes>
            <class name="brightlyTestQa.ui.test.ErrorValidationTest"/>
        </classes>
    </test>
    <test name="BookFlight">
        <classes>
            <class name="brightlyTestQa.ui.test.BookFlightTest"/>
        </classes>
    </test>
</suite>